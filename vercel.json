{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/dispatch.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:resource/:path*",
      "destination": "/api/dispatch?__route=:resource/:path*"
    }
  ]
}
